{
  "name": "step-by-step-diagnostic-navigator",
  "version": "0.3.0",
  "private": true,
  "description": "Пошаговая памятка диагностики устройств ДЦ",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop": "node scripts/ensure-electron.mjs && npm run build && electron .",
    "desktop:pack": "node scripts/ensure-electron.mjs && npm run build && electron-builder --win portable --x64 --publish never",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "test": "node --test tests/graph.test.js tests/indication.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.64.1",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "ru.navigator.dc",
    "productName": "ДЦ Навигатор",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DC-Navigator-${version}-Windows-${arch}.${ext}",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    }
  }
}
